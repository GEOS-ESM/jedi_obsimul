ana_surf.deflate:           1 ,
ana_surf.grid_label:        PC1440x721-DC ,
ana_surf.mode:             'time-averaged'
ana_surf.regrid_method:    'CONSERVE',
ana_surf.ref_time:          210000 ,
ana_surf.frequency:         010000 ,
ana_surf.fields:            include(surf_vars.vl)
