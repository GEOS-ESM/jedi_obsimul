# 3D Aerosol Mixing Ratio
# -----------------------
tavg3d_aer_p.template:       '%y4%m2%d2_%h2%n2z.nc4',
tavg3d_aer_p.archive:        '%c/Y%y4',
tavg3d_aer_p.format:         'CFIO',
tavg3d_aer_p.nbits:             12,
tavg3d_aer_p.chunksize:         180 91 1 1,
tavg3d_aer_p.deflate:         1,
tavg3d_aer_p.grid_label:      PC720x361-DC,
tavg3d_aer_p.mode:           'instantaneous',
#  tavg3d_aer_p.monthly:         1,
tavg3d_aer_p.frequency:       010000,
# tavg3d_aer_p.ref_time:        210000,
tavg3d_aer_p.regrid_method:   'CONSERVE',
tavg3d_aer_p.splitField:      1,
tavg3d_aer_p.vscale:          100.0,
tavg3d_aer_p.vunit:          'hPa',
tavg3d_aer_p.vvars:          'log(PLE)'    , 'DYN'        ,
tavg3d_aer_p.levels:          include(press_26levels.vl)
tavg3d_aer_p.fields:          include(aer3Dp_vars.vl)
::


