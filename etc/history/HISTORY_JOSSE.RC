#ana_slv.frequency:         010000 ,
#ana_slv.fields:            include(slv_vars.vl)  ##### add w at several levels
::

ana_surf.template:         '%y4%m2%d2_%h2%n2z.nc4' ,
ana_surf.archive:          '%c/Y%y4' ,
ana_surf.format:           'CFIO' ,
ana_surf.nbits:             12,
ana_surf.chunks:            180 91 1 1,
ana_surf.deflate:           1 ,
ana_surf.grid_label:        PC1440x721-DC ,
ana_surf.mode:             'time-averaged'
ana_surf.regrid_method:    'CONSERVE',
ana_surf.ref_time:          210000 ,
ana_surf.frequency:         010000 ,
ana_surf.fields:            include(surf_vars.vl)
::

# Browsing product
# Met/Aerosol/Carbon Single Level Variables
# ------------------------------------------
inst_01hr_2d_brs_Nx.format:      'CFIO' ,
inst_01hr_2d_brs_Nx.descr:       '2d,1-Hourly,Instantaneous,Hi-Res Lat-Lon on Single-Level,Assimilation,Meteorological, Carbon and Aerosol Single-Level Diagnostics' ,
inst_01hr_2d_brs_Nx.grid_label:  PC2880x1441-DC ,
inst_01hr_2d_brs_Nx.nbits:       12,
inst_01hr_2d_brs_Nx.chunksize:   180 91 1 1,
inst_01hr_2d_brs_Nx.deflate:     1,
inst_01hr_2d_brs_Nx.template:    '%y4%m2%d2_%h2%n2z.nc4' ,
inst_01hr_2d_brs_Nx.mode:        'instantaneous' ,
inst_01hr_2d_brs_Nx.frequency:   010000 ,
inst_01hr_2d_brs_Nx.duration:    010000 ,
inst_01hr_2d_brs_Nx.fields:      include(brs_vars.vl)
::

    
# Prognostic variables on pressure levels
# ---------------------------------------    
geosgcm_prog.template:         '%y4%m2%d2_%h2%n2z.nc4' ,
geosgcm_prog.archive:          '%c/Y%y4' ,
geosgcm_prog.format:           'CFIO' ,
geosgcm_prog.nbits:             12,
geosgcm_prog.chunksize:         180 91 1 1,
geosgcm_prog.deflate:           1 ,
geosgcm_prog.grid_label:        PC720x361-DC ,
geosgcm_prog.regrid_method:    'BILINEAR',
geosgcm_prog.frequency:         010000 ,
geosgcm_prog.vscale:            100.0 ,
geosgcm_prog.vunit:            'hPa' ,
geosgcm_prog.vvars:            'log(PLE)' , 'DYN' ,
geosgcm_prog.levels:           include(press_48levels.vl)
geosgcm_prog.fields:           include(prog_vars.vl)
::
  
