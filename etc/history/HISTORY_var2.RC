# Prognostic variables for analysis verification
# ----------------------------------------------
ana_prog.template:         '%y4%m2%d2_%h2%n2z.nc4' ,
ana_prog.archive:          '%c/Y%y4' ,
ana_prog.format:           'CFIO' ,
ana_prog.nbits:             12,
ana_prog.chunks:            180 91 1 1,
ana_prog.deflate:           1 ,
ana_prog.grid_label:        PC1440x721-DC ,
ana_prog.regrid_method:    'BILINEAR',
ana_prog.ref_time:          210000 ,
ana_prog.frequency:         010000 ,
ana_prog.fields:            include(ana_vars.vl)
::

