# ------------------------------------------
inst_01hr_2d_brs_Nx.format:      'CFIO' ,
inst_01hr_2d_brs_Nx.descr:       '2d,1-Hourly,Instantaneous,Hi-Res Lat-Lon on Single-Level,Assimilation,Meteorological, Carbon and Aerosol Single-Level Diagnostics' ,
inst_01hr_2d_brs_Nx.grid_label:  PC2880x1441-DC ,
inst_01hr_2d_brs_Nx.nbits:       12,
inst_01hr_2d_brs_Nx.chunksize:   180 91 1 1,
inst_01hr_2d_brs_Nx.deflate:     1,
inst_01hr_2d_brs_Nx.template:    '%y4%m2%d2_%h2%n2z.nc4' ,
inst_01hr_2d_brs_Nx.mode:        'instantaneous' ,
inst_01hr_2d_brs_Nx.frequency:   010000 ,
inst_01hr_2d_brs_Nx.duration:    010000 ,
inst_01hr_2d_brs_Nx.fields:      include(brs_vars.vl)
::


