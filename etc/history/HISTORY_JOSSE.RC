#
#  To generarate a valid GEOS history file, process this file with m4:
#
#  % m4 < HISTORY_JOSSE.RC > HISTORY_JOSSE.rc
#
#  ( if separate jedi super collection into 29 collections:
#  % sh separate_jedi_to_29_collections.j
#  % output:  HISTORY_J29.rc
#  )

include(warning.vl)

VERSION: 1
EXPID:  AIST_c180_L137
EXPDSC: AIST-nr
EXPSRC: GEOSgcm-v12
#ServerSizeSplit: 81
#CollectionWriteSplit: 7

#                              -------------------------    
#                               Selection of Collections
#                              -------------------------    

COLLECTIONS:
#              'geosgcm_prog'
              'jedi'
::

qqCOLLECTIONS:
    include(jedi_collection_names.vl)
::


#                              ----------------------    
#                              Grid Definition Macros
#                              ----------------------    

# ---
# N.B.: This set of labels must appear after the main list of COLLECTIONS.
# ---
    
GRID_LABELS: 

#    Global Grids
#    ------------
     PC720x361-DC        # 0.5    x 0.625   deg     (<==> c180)
#     PC1440x721-DC       # 0.25   x 0.3125  deg     (<--> c360)
#     PC2880x1441-DC      # 0.125  x 0.0625  deg     (<--> c720)
#     PC5760x2881-DC      # 0.0625 x 0.03125 deg     (<--> c1140)
#     PC11520x5761-DC     # 112.5  x 56.25   arcsec  (<--> c2880)
#    
##    Sampler Geometries
##    ------------------
##     SwathGrid_MYD04     ygyu: 3/5/25 data directory missing
##     SwathGrid_MOD04     ygyu: 3/5/25 data directory missing
#     SwathGrid_ATMS
#     abi_grid_GOES16_M6C14
    
::

#                              ------------------------    
#                              Grid Geometry Definition
#                              ------------------------    


PC720x361-DC.GRID_TYPE: LatLon
PC720x361-DC.IM_WORLD:  720
PC720x361-DC.JM_WORLD:  361
PC720x361-DC.POLE: PC
PC720x361-DC.DATELINE:  DC
PC720x361-DC.LM: 181


#                              ---------------------------------    
#                              Definition of Gridded Collections
#                              ---------------------------------    

    
# Prognostic variables on pressure levels
# ---------------------------------------    
geosgcm_prog.template:         '%y4%m2%d2_%h2%n2z.nc4' ,
geosgcm_prog.archive:          '%c/Y%y4' ,
geosgcm_prog.format:           'CFIO' ,
geosgcm_prog.deflate:           1 ,
geosgcm_prog.grid_label:        PC720x361-DC ,
geosgcm_prog.regrid_method:    'BILINEAR',
geosgcm_prog.frequency:         010000 ,
geosgcm_prog.vscale:            100.0 ,
geosgcm_prog.vunit:            'hPa' ,
geosgcm_prog.vvars:            'log(PLE)' , 'DYN' ,
geosgcm_prog.levels:           include(press_48levels.vl)
geosgcm_prog.fields:           include(prog_vars.vl)
::


  jedi.sampler_spec:         trajectory
  jedi.ObsPlatforms:         aircraft airs_aqua amsr2_gcom-w1 amsua_aqua amsua_metop-b amsua_n15 amsua_n18 amsua_n19 atms_n20 atms_npp avhrr3_metop-b avhrr3_n18 avhrr3_n19 cris-fsr_n20 cris-fsr_npp gmi_gpm gps iasi_metop-b mhs_metop-b mhs_n19 mls55_aura omi_aura ompsnm_npp satwind scatwind sfc sfcship sondes ssmis_f17
  jedi.template:             '%y4%m2%d2_%h2%n2z.nc4',
  jedi.format:               'CFIO',
  jedi.obs_file_begin:       2019-07-31T21:00:00
  jedi.obs_file_interval:    '000000 060000'    #  fixed string format:  yymmdd hhmmss
  jedi.obs_file_end:         2019-11-01T00:00:00
  jedi.Epoch:                060000             #  fixed integer format:  hhmmss
  jedi.use_NWP_1_file:       .true.
  jedi.restore_2_obs_vector: .true.
  jedi.regrid_method:        'BILINEAR' ,
  jedi.splitField:           1,
::


include(jedi_29_collections.set)


#                              -------------------------    
#                              JEDI Platform Definitions
#                              -------------------------

    #ams This does not make sense. This is in confounding geometry and collection
    #    specifications.  For a given collection, one could elect to write more
    #    than 1 collextion. It is all entagled. Needs refactoring.
    #
    #    IODA_SCHEMA is completely inadequate for CAMP2EX, FIREX-AQ; these have
    #    absolutely to do with JEDI's IODA format.
    
    #    Now, for bina fide IODA trajecories, the IODA_SCHEMA parameters index_name_x, ..., var_name_time 
    #    should be the default. Better yet, this is a IODA convention, no need to allow it to be redfined.
    #
    #    Really, when defining the geometries for trajectory one could define
    #       SCHEMA: IODA or Generic
    #    If SCHEMA is IODA, then this is implied (notice that I changed the label names):
    #        index_dim_name:      Location
    #        lon_var_name:        MetaData/longitude
    #        lat_var_name:        MetaData/latitude
    #        time_var_name:       MetaData/dateTime
    #    If SCHEMA is Generic, then these attributes ought to be specified.
    #

    
DEFINE_OBS_PLATFORM::

#PLATFORM.CAMP2EX::
#  IODA_SCHEMA::
#    index_name_x:     time
#    var_name_lon:     trjLon
#    var_name_lat:     trjLat
#    var_name_time:    time
#    file_name_template:  /discover/nobackup/projects/gmao/aist-nr/data/CAMP2EX/sampled/P3B/GEOS-FP/%y4-%m2-%d2/CAMP2Ex-GEOS-FP-adg-Nx-P3B_Model_%y4%m2%d2_R1.nc
#  ::
#  GEOVALS_SCHEMA::
#    geovals_fields::
#                      include(aerSampler_vars.vl)
#                      include(cldSampler_vars.vl)
#                      include(asmSampler_vars.vl)
#    ::
#  ::
#::
#
#PLATFORM.FIREXAQ::
#  IODA_SCHEMA::
#    index_name_x:       time
#    var_name_lon:       trjLon
#    var_name_lat:       trjLat
#    var_name_time:      time
#    file_name_template: /discover/nobackup/projects/gmao/aist-nr/data/FIREX-AQ/sampled/DC8/GEOS-FP/%y4-%m2-%d2/FIREXAQ-GEOS-FP-adg-Nx-DC8_Model_%y4%m2%d2_R1.nc
#  ::
#  GEOVALS_SCHEMA::
#    geovals_fields::
#                         include(aerSampler_vars.vl)
#                         include(cldSampler_vars.vl)
#                         include(asmSampler_vars.vl)
#    ::
#  ::
#::
#
#


PLATFORM.airs_aqua::
  IODA_SCHEMA::
    index_name_x:        Location
    var_name_lon:        MetaData/longitude
    var_name_lat:        MetaData/latitude
    var_name_time:       MetaData/dateTime
    file_name_template:  /discover/nobackup/projects/gmao/aist-nr/data/ioda_reshuffle/%y4%m2%d2/geos_atmosphere/airs_aqua.%y4%m2%d2T%h2%n2%S2Z.nc4
  ::
  GEOVALS_SCHEMA::
    geovals_fields:: 
                         include(crtmSampler_vars.vl)
    ::
  ::
::



