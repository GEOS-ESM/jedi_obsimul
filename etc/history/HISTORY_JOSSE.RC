  Aeronet.template:           %y4%m2%d2_%h2%n2z.nc4
  Aeronet.format:             'CFIO'
  Aeronet.frequency:          010000,   # when to write
  Aeronet.duration:           060000,   # time length to update file
  Aeronet.splitField:         1,
  Aeronet.regrid_method:      'BILINEAR' ,
  Aeronet.fields:             include(aerSampler_vars.vl)
                              include(cldSampler_vars.vl)
                              include(asmSampler_vars.vl)
::


  SNDR_ATMS.observation_spec:  'Swath'
  SNDR_ATMS.template:          '%y4%m2%d2_%h2%n2z.nc4',
  SNDR_ATMS.format:            'CFIO',
  SNDR_ATMS.frequency:         060000,
  SNDR_ATMS.grid_label:        SwathGrid_ATMS,
  SNDR_ATMS.regrid_method:     'BILINEAR' ,
  SNDR_ATMS.fields:            include(crtmSampler_vars.vl)
::

